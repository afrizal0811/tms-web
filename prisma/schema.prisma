// File: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Hub {
  id                  String            @id
  name                String
  acronym             String?
  has_pending_gr      Boolean           @default(false)
  has_partial_routing Boolean           @default(false)
  has_vms             Boolean           @default(false)
  time_zone           TimeZone          @default(WIB)
  lat                 Float?
  lng                 Float?
  update_by           String?
  updated_at          DateTime          @updatedAt
  is_active           Boolean           @default(true)
  drivers             Driver[]
  routing_results     RoutingResult[]
  tasks               Task[]
  location_histories  LocationHistory[]

  @@map("hubs")
}

model Driver {
  id               String   @id
  vehicle_id       String? 
  vms_id           String?
  imei             String?
  vms_driver_id    String?
  email            String
  name             String
  plat             String?
  type             String?
  start_time       String?
  end_time         String?
  start_break_time String? 
  end_break_time   String?
  multiday         Int?
  speed            Float? 
  cost_factor      Float? 
  tags             String? 
  odd_even         String? 
  min_weight       Float?  
  max_weight       Float?
  min_volume       Float?
  max_volume       Float?
  storage          String?
  update_by        String?
  updated_at       DateTime @updatedAt

  hubs             Hub[]    

  @@map("drivers")
}

model Role {
  id         String   @id
  name       String
  paths      String[] @default([])
  update_by  String?
  updated_at DateTime @updatedAt

  @@map("roles")
}

model VehicleType {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("vehicle_type")
}

model VehicleMapping {
  id          Int      @id @default(autoincrement())
  plat        String   @unique
  mapped_type String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("vehicle_mappings")
}


model TruckUsage {
  id           Int      @id @default(autoincrement())
  hub_id       String
  date         String  
  storage_type String   
  vehicle_type String 
  count        Int      
  description  String?  @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([hub_id, date, storage_type, vehicle_type])
  @@map("truck_usages")
}

model Reason {
  id          Int      @id @default(autoincrement())
  reasons     String 
  pic         String
  category    String?
  lastUpdated DateTime @updatedAt @default(now())

  @@unique([reasons, pic])
  @@map("reasons")
}

model PendingDetail {
  id               String   @id @default(cuid())
  task_id          String   @unique
  date             String  
  new_status       String?
  internal_external String?
  detail_reason    String?  @db.Text
  group_reason     String?
  pic              String?
  created_by       String?
  updated_by       String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("pendings")
}

model RoutingResult {
  id                 String   @id
  hub_id             String
  name               String
  delivery_date      String
  route_user         Json?

  total_distance     Json?    @default("{}")
  time               Json?    @default("{}")
  hub_times          Json?    @default("{}")

  dropped            Int      @default(0)
  histories          Json?

  sync_user          Json?

  hub                Hub      @relation(fields: [hub_id], references: [id])

  @@index([hub_id, delivery_date])
  @@index([delivery_date])
  @@map("routing_results")
}

model Task {
  id                  String   @id
  hub_id              String
  routing_result_id   String?

  customer_order      String?  @db.Text
  address             String?  @db.Text
  flow                String?
  type_storage        String?

  status              String?
  status_delivery     String?
  alasan              String?  @db.Text

  delivery_date       String
  start_time          String?
  end_time            String?
  assigned_time       String?
  done_time           String?
  arrival_time        String?

  assigned_vehicle_id String?
  assignee            String?
  driver_name         String?
  plat                String?
  vehicle_type        String?
  route_planned_order Int?

  weight_kg           Float?
  volume_cbm          Float?
  distance            Float?
  travel_distance     Float?
  travel_duration     String?
  eta                 String?
  etd                 String?

  expected_coordinate String?
  done_coordinate     String?
  new_coordinate      String?

  list_product        Json?
  others              Json?

  created_from        String?
  sync_user           Json?
  task_user           Json?

  hub                 Hub            @relation(fields: [hub_id], references: [id])

  @@index([hub_id, delivery_date])
  @@index([delivery_date])
  @@index([routing_result_id])
  @@index([status_delivery])
  @@index([plat])
  @@map("tasks")
}

enum TimeZone {
  WIB
  WITA
  WIT
}


model LocationHistory {
  id             String   @id
  hub_id         String?
  email          String
  driver_name    String?

  date           String
  start_time     String
  finish_time    String?

  total_duration Int?
  total_distance Float?
  tracked_time   Float?

  start_lat      Float?
  start_lon      Float?
  finish_lat     Float?
  finish_lon     Float?

  sync_user      Json?

  hub            Hub?     @relation(fields: [hub_id], references: [id])

  @@index([hub_id, date])
  @@index([date])
  @@index([email, date])
  @@index([driver_name, date])
  @@map("location_histories")
}
