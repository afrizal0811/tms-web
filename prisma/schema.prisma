// File: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Hub {
  id           String   @id
  name         String
  acronym      String?
  hasPendingGR Boolean  @default(false)
  hasPartialRouting Boolean  @default(false)
  has_vms      Boolean @default(false)
  time_zone    TimeZone @default(WIB) @map("time_zone")
  lat          Float?
  lng          Float?  
  updateBy     String?
  updatedAt    DateTime @updatedAt
  drivers         Driver[] 
  routing_results RoutingResult[]
  tasks           Task[]
  is_active       Boolean @default(true)
}

model Driver {
  id             String   @id
  vehicle_id     String? 
  vms_id         String?
  imei           String?
  vms_driver_id  String?
  email          String
  name           String
  plat           String?
  type           String?
  startTime      String?
  endTime        String?
  startBreakTime String? 
  endBreakTime   String?
  multiday       Int?
  speed          Float? 
  costFactor     Float? 
  tags           String? 
  oddEven        String? 
  minWeight      Float?  
  maxWeight      Float?
  minVolume      Float?
  maxVolume      Float?
  storage        String?
  updateBy       String?
  updatedAt      DateTime @updatedAt

  hubs           Hub[]    

  @@map("drivers")
}

model Role {
  id        String   @id
  name      String
  paths     String[] @default([])
  updateBy  String?
  updatedAt DateTime @updatedAt
}

model VehicleType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicle_type")
}

model VehicleMapping {
  id         Int      @id @default(autoincrement())
  plat       String   @unique
  mappedType String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("vehicle_mappings")
}


model TruckUsage {
  id          Int      @id @default(autoincrement())
  hubId       String
  date        String  
  storageType String   
  vehicleType String 
  count       Int      
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([hubId, date, storageType, vehicleType])
  @@map("truck_usages")
}

model Reason {
  id          Int      @id @default(autoincrement())
  reasons     String 
  pic         String
  category    String?
  lastUpdated DateTime @updatedAt @default(now())

  @@unique([reasons, pic])
  @@map("reasons")
}

model PendingDetail {
  id               String   @id @default(cuid())
  taskId           String   @unique
  date             String  
  new_status       String?
  internalExternal String?
  detailReason     String?  @db.Text
  groupReason      String?
  pic              String?
  created_by       String?
  updated_by       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("pending_details")
}

model RoutingResult {
  id                 String   @id
  hub_id             String
  name               String
  delivery_date      String
  route_user         Json?

  total_distance     Json?    @default("{}")
  time               Json?    @default("{}")
  hub_times          Json?    @default("{}")

  dropped            Int      @default(0)
  histories          Json?

  sync_user          Json?

  hub                Hub      @relation(fields: [hub_id], references: [id])

  @@index([hub_id, delivery_date])
  @@index([delivery_date])
  @@map("routing_results")
}

model Task {
  id                  String   @id
  hub_id              String
  routing_result_id   String?

  customer_order      String?  @db.Text
  address             String?  @db.Text
  flow                String?
  type_storage        String?

  status              String?
  status_delivery     String?
  alasan              String?  @db.Text

  delivery_date       String
  start_time          String?
  end_time            String?
  assigned_time       String?
  done_time           String?
  arrival_time        String?

  assigned_vehicle_id String?
  assignee            String?
  driver_name         String?
  plat                String?
  vehicle_type        String?
  route_planned_order Int?

  weight_kg           Float?
  volume_cbm          Float?
  distance            Float?
  travel_distance     Float?
  travel_duration     String?
  eta                 String?
  etd                 String?

  expected_coordinate String?
  done_coordinate     String?
  new_coordinate      String?

  list_product        Json?
  others              Json?

  created_from        String?
  sync_user           Json?
  task_user           Json?

  hub                 Hub            @relation(fields: [hub_id], references: [id])

  @@index([hub_id, delivery_date])
  @@index([delivery_date])
  @@index([routing_result_id])
  @@index([status_delivery])
  @@index([plat])
  @@map("tasks")
}

enum TimeZone {
  WIB
  WITA
  WIT
}
