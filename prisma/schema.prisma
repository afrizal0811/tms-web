// File: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Tabel untuk menyimpan data tugas tambahan manual
model ManualTask {
  id            Int      @id @default(autoincrement())
  driverName    String
  customerName  String
  soNumber      String
  flow          String
  createdAt     DateTime @default(now())
}

// Tabel untuk menyimpan data Cabang/Hub dari Vendor
model Hub {
  id        String   @id
  name      String
  updatedAt DateTime @updatedAt
}

// Tabel untuk menyimpan data Role dari Vendor
model Role {
  id        String   @id
  name      String
  updatedAt DateTime @updatedAt
}